; RuntimeMessage is encoded as a minicbor enum [stable-tag, typed-body].
runtime-message =
  [0, client-hello] /
  [1, server-hello] /
  [2, version-rejected] /
  [10, project-manifest] /
  [11, project-load-report] /
  [12, reload-project] /
  [20, start-request] /
  [21, runtime-state] /
  [30, frontend-input] /
  [31, advance-time] /
  [32, wait-change] /
  [33, any] /
  [34, any] /
  [40, presentation-snapshot] /
  [41, presentation-delta] /
  [42, any] /
  [43, any] /
  [50, storage-request] /
  [51, storage-response] /
  [52, service-request] /
  [53, service-response] /
  [60, state-export-request] /
  [61, state-export-ready] /
  [62, state-import-begin] /
  [63, state-import-accepted] /
  [64, state-import-chunk] /
  [65, state-import-commit] /
  [66, state-import-ready] /
  [67, state-export-chunk-request] /
  [68, state-export-chunk] /
  [69, state-transfer-cancel] /
  [90, shutdown-request] /
  [91, shutdown-ready] /
  [92, runtime-fault] /
  [93, any] /
  [94, any] /
  [95, command-rejected] /
  [96, any]

client-hello = { 0: any, 1: tstr, 2: [* uint], 3: runtime-limits, 4: any, 5: [* tstr] }
server-hello = { 0: any, 1: any, 2: [* uint], 3: runtime-limits, 4: uint, 5: any, 6: tstr }
runtime-limits = { 0: uint, 1: uint, 2: uint, 3: uint, 4: uint, 5: uint }
version-rejected = { 0: any, 1: tstr }
project-manifest = { 0: uint, 1: [* any] }
project-load-report = { 0: uint, 1: bool, 2: [* any] }
reload-project = { 0: uint, 1: uint, 2: [* any] }
start-request = { 0: any }
runtime-state = { 0: uint, 1: uint, 2: uint }
frontend-input = { 0: uint, 1: uint, 2: uint, 3: any }
advance-time = { 0: uint }
wait-change = any
presentation-snapshot = any
presentation-delta = { 0: uint, 1: uint, 2: [* any] }
storage-request = { 0: uint, 1: uint, 2: tstr, 3: storage-operation, 4: tstr, 5: uint / null }
storage-response = { 0: uint, 1: any }
storage-operation =
  [0] /
  [1, bstr, bool, storage-precondition] /
  [2, tstr / null, bool] /
  [3, storage-precondition] /
  [4]
storage-precondition = [0] / [1] / [2, tstr]
service-request = { 0: uint, 1: uint, 2: tstr, 3: any, 4: bstr }
service-response = { 0: uint, 1: any }
state-export-request = { 0: uint }
state-export-ready = { 0: uint, 1: any }
state-import-begin = { 0: uint, 1: uint, 2: bstr, 3: bstr / null }
state-import-accepted = { 0: uint }
state-import-chunk = { 0: uint, 1: uint, 2: bstr }
state-import-commit = { 0: uint }
state-import-ready = { 0: uint, 1: uint }
state-export-chunk-request = { 0: uint, 1: uint, 2: uint }
state-export-chunk = { 0: uint, 1: uint, 2: bstr, 3: bool }
state-transfer-cancel = { 0: uint }
shutdown-request = { 0: bool }
shutdown-ready = { 0: uint, 1: uint }
runtime-fault = { 0: uint, 1: tstr, 2: any / null }
command-rejected = { 0: uint, 1: tstr, 2: bool, 3: any / null }
