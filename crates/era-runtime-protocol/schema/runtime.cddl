; RuntimeMessage is encoded as a minicbor enum [stable-tag, typed-body].
runtime-message =
  [0, client-hello] /
  [1, server-hello] /
  [2, version-rejected] /
  [10, project-manifest] /
  [11, project-load-report] /
  [12, reload-project] /
  [20, start-request] /
  [21, runtime-state] /
  [30, frontend-input] /
  [31, advance-time] /
  [32, wait-change] /
  [33, any] /
  [34, any] /
  [40, presentation-snapshot] /
  [41, presentation-delta] /
  [42, any] /
  [43, any] /
  [50, storage-request] /
  [51, storage-response] /
  [52, service-request] /
  [53, service-response] /
  [60, state-export-request] /
  [61, state-export-ready] /
  [90, shutdown-request] /
  [91, shutdown-ready] /
  [92, runtime-fault] /
  [93, any] /
  [94, any] /
  [95, command-rejected] /
  [96, any]

client-hello = { 0: any, 1: tstr, 2: [* uint], 3: any, 4: any }
server-hello = { 0: any, 1: any, 2: [* uint], 3: any, 4: uint, 5: any }
version-rejected = { 0: any, 1: tstr }
project-manifest = { 0: uint, 1: [* any] }
project-load-report = { 0: uint, 1: bool, 2: [* any] }
reload-project = { 0: uint, 1: uint, 2: [* any] }
start-request = { 0: any }
runtime-state = { 0: uint, 1: uint, 2: uint }
frontend-input = { 0: uint, 1: uint, 2: uint, 3: any }
advance-time = { 0: uint }
wait-change = any
presentation-snapshot = any
presentation-delta = { 0: uint, 1: uint, 2: [* any] }
storage-request = { 0: uint, 1: uint, 2: tstr, 3: any, 4: tstr }
storage-response = { 0: uint, 1: any }
service-request = { 0: uint, 1: uint, 2: tstr, 3: any, 4: bstr }
service-response = { 0: uint, 1: any }
state-export-request = { 0: uint }
state-export-ready = { 0: uint, 1: any }
shutdown-request = { 0: bool }
shutdown-ready = { 0: uint, 1: uint }
runtime-fault = { 0: uint, 1: tstr, 2: any / null }
command-rejected = { 0: uint, 1: tstr, 2: bool, 3: any / null }
