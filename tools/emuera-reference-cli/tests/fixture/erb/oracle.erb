@SYSTEM_TITLE
PRINTFORML TITLE_CHARANUM={CHARANUM}
PRINTL ORACLE_READY
IF 0
    CALL ORACLE_TEST
    CALL ORACLE_INPUT
    CALL ORACLE_MAP
    CALL ORACLE_STRUCTURED
    CALL ORACLE_PRESENTATION
    CALL ORACLE_HTML_POP
    CALL ORACLE_NATIVE
    CALL ORACLE_REFLECTION
    CALL ORACLE_COMPAT
    CALL ORACLE_COMPAT_REST
ENDIF
INPUT
RETURN

@ORACLE_COMPAT
RESULT = 0
TRYCALLFORM ORACLE_MISSING(1 / LOCAL)
CALLFORM ORACLE_DYNAMIC_{1}(4)
RETURN

@ORACLE_DYNAMIC_1(ARG)
FLAG:0 = ARG
RETURN

@ORACLE_COMPAT_REST
RESULT:1 = 99
PRINTDATA RESULT:1
DATA PICKED
ENDDATA
STRDATA RESULTS:10
DATA STORED
ENDDATA
TRYCALLLIST
FUNC ORACLE_MISSING, 1 / LOCAL
FUNC ORACLE_LIST_TARGET, 7
ENDFUNC
RESULT:4 = 0
TRYCCALL ORACLE_DYNAMIC_1, 1
RESULT:4 = 1
CATCH
RESULT:4 = 2
ENDCATCH
RESULT:5 = 0
TRYCCALL ORACLE_MISSING
RESULT:5 = 1
CATCH
RESULT:5 = 2
ENDCATCH
RESULTS:11 = %"ORACLE_MISSING_LABEL"%
TRYCGOTOFORM %RESULTS:11%
CATCH
RESULT:2 = 3
ENDCATCH
TRYGOTOLIST
FUNC ORACLE_MISSING_LABEL
FUNC ORACLE_FOUND_LABEL
ENDFUNC
RESULT:3 = 99
$ORACLE_FOUND_LABEL
RESULT:3 = 4
CALLEVENT EVENTFIRST
RETURN

@ORACLE_LIST_TARGET(ARG)
FLAG:1 = ARG
RETURN

@EVENTFIRST
FLAG:2 += 8
RETURN

@ORACLE_PRESENTATION
PRINTBUTTON "A", 1
PRINTBUTTONC "B", 2
PRINTBUTTONLC "C", 3
PRINTL
DRAWLINE
NOSKIP
PRINTL VISIBLE
ENDNOSKIP
RETURN

@ORACLE_HTML_POP
PRINTPLAIN A<&
PRINTBUTTON "choose", 42
RESULTS:30 = %HTML_POPPRINTINGSTR()%
RETURN

@ORACLE_PRESENTATION_23
PRINT [0x10] hex [1e2] exponent
RESULTS:31 = %HTML_POPPRINTINGSTR()%
PRINT_IMG "missing", "hover", "mask", 20, 10 px, 7 px
RESULTS:32 = %HTML_POPPRINTINGSTR()%
PRINT_RECT 1 px, 2, 3 px, 4
RESULTS:33 = %HTML_POPPRINTINGSTR()%
PRINT_SPACE 5 px
RESULTS:34 = %HTML_POPPRINTINGSTR()%
RETURN

@ORACLE_TEST
PRINTL ORACLE_OK
RETURN

@ORACLE_NATIVE
#DIMS PARTS, 4
#DIMS JOINED, 4
RESULT:0 = 0
SETBIT RESULT:0, 1, 3
INVERTBIT RESULT:0, 1
CLEARBIT RESULT:0, 3
SPLIT "a//b/", "/", PARTS, RESULT:1
RESULT:2 = STRCOUNT("ababa", "aba")
RESULT:3 = GETPALAMLV(499, 5)
RESULTS:0 = %ESCAPE("a+b")%
JOINED:0 = %"a"%
JOINED:1 = %"b"%
JOINED:2 = %"c"%
RESULT:4 = STRLENS("Ab")
RESULT:5 = STRLENSU("Aé")
RESULT:12 = STRLENSU("😀")
RESULT:6 = STRFINDU("aβc", "β")
RESULT:7 = ENCODETOUNI("β")
RESULT:8 = UNICODEBYTE("β")
RESULTS:1 = %CHARATU("aβ", 1)%
RESULTS:2 = %TOUPPER("Abc")%
RESULTS:3 = %TOLOWER("AbC")%
RESULTS:4 = %STRJOIN(JOINED, "/", 1, 2)%
RESULTS:5 = %STRJOIN(JOINED)%
RESULTS:6 = %UNICODE(946)%
RESULT:9 = TOINT("12.9")
RESULT:10 = ISNUMERIC("0x10")
RESULT:11 = COLOR_FROMRGB(1, 2, 3)
RESULTS:7 = %CONVERT(255, 16)%
RETURN

@ORACLE_INPUT
PRINTL ORACLE_WAITING
INPUT
PRINTFORML ORACLE_GOT={RESULT}
RETURN RESULT

@ORACLE_REFLECTION
#DIMS NAMES, 4
RESULT:12 = ENUMFUNCWITH("ORACLE_REFLECTION", NAMES)
RESULTS:8 = %NAMES:0%
RESULT:13 = ENUMVARWITH("SAVEDATA_TEXT", NAMES)
RESULTS:9 = %NAMES:0%
RETURN

@ORACLE_MAP
#DIMS KEYS, 4
RESULT:0 = MAP_CREATE("m")
RESULT:1 = MAP_SET("m", "b", "1")
RESULT:2 = MAP_SET("m", "a", "2")
RESULT:3 = MAP_SET("m", "b", "3")
RESULTS:0 = %MAP_GET("m", "b")%
RESULTS:1 = %MAP_GETKEYS("m")%
RESULTS:2 = %MAP_GETKEYS("m", KEYS, 1)%
PRINTFORML MAP={RESULT:0},{RESULT:1},{RESULT:2},{RESULT:3}|%RESULTS:0%|%RESULTS:1%
RETURN

@ORACLE_STRUCTURED
#DIMS SCHEMA
#DIMS XML
RESULT:0 = DT_CREATE("table")
RESULT:1 = DT_COLUMN_ADD("table", "name", "string", 1)
RESULT:2 = DT_COLUMN_ADD("table", "score", "int32", 0)
RESULT:3 = DT_ROW_ADD("table", "name", "A&B", "score", 7)
XML = %DT_TOXML("table", SCHEMA)%
RESULTS:0 = %SCHEMA%
RESULTS:1 = %XML%
RESULTS:2 = %"<root><item id=\"a\">one</item><item id=\"b\">two</item></root>"%
RESULT:4 = XML_SET(RESULTS:2, "//item[@id='b']", "changed", 0, 1)
RESULT:5 = XML_ADDATTRIBUTE(RESULTS:2, "//item[@id='a']", "kind", "first")
RETURN

@ORACLE_COMPAT_12
#DIMS TAGS, 8
HTML_TAGSPLIT "a<b>x</b>", TAGS, RESULT:20
RESULTS:20 = %HTML_ESCAPE("<&>'\"")%
RESULTS:21 = %HTML_TOPLAINTEXT("<b>A&amp;B</b><br>&#x3042;")%
RESULT:21 = FLOWINPUT(7, 1, 1, 0)
RESULT:22 = FLOWINPUTS(1, "fallback")
BAR 5, 10, 4
BARL 1, 4, 4
SETCOLOR 66051
RESULT:23 = GETCOLOR()
FONTBOLD
FONTITALIC
RESULT:24 = GETSTYLE()
FONTREGULAR
RESULTS:22 = %CURRENTALIGN()%
RETURN
