@ORACLE_RESTART_FLOW
CALL ORACLE_RESTART_MOVE
CALL ORACLE_RESTART_ABILITY
RETURN

@ORACLE_RESTART_MOVE
#DIM DISPLAY
PRINTFORML move display={DISPLAY}
PRINTBUTTON "[C]", "C"
PRINTBUTTON "[0]", "0"
INPUTS
SELECTCASE RESULTS
CASE "C"
DISPLAY += 1
RESTART
CASE "0"
RETURN
ENDSELECT
PRINTL invalid move
RETURN

@ORACLE_RESTART_ABILITY
#DIM PAGE
PRINTFORML ability page={PAGE}
PRINTBUTTON "[6]", 6
PRINTBUTTON "[0]", 0
INPUT
SELECTCASE RESULT
CASE 6
PAGE += 1
RESTART
CASE 0
RETURN
ENDSELECT
PRINTL invalid ability
RETURN
