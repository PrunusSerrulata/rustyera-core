@PROBE_NATIVE_STRJOIN_REF_OMISSION
#LOCALSIZE 2
FLAG:0 = 1
LOCAL:0 = 7
LOCAL:1 = 8
LOCALS '= "%HOST_JOIN_REF(LOCAL)%"
