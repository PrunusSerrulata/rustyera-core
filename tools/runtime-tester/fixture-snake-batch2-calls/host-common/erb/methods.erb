RETURN

@HOST_SIDE
#FUNCTION
FLAG:8 += 1
RETURNF 1

@HOST_WIDTH
#FUNCTION
FLAG:8 += 1
RETURNF 0

@HOST_JOIN_REF(ITEMS)
#FUNCTIONS
#DIM REF ITEMS
LOCALS '= "%STRJOIN(ITEMS)%"
RESULTS:11 '= STRFORM(LOCALS)
LOCALS '= "%STRJOIN(ITEMS,,0,2)%"
RETURNF STRFORM(LOCALS)
