@TAKE(ARG)
FLAG:2 = 1
RESULT:11 = ARG
RETURN
@TAKES(ARGS)
FLAG:2 = 1
RESULTS:11 '= ARGS
RETURN
@DROP(ARG)
#FUNCTION
RETURNF ARG
@SIDE
#FUNCTION
FLAG:8 += 1
RETURNF 0
@USE(ITEMS)
#FUNCTION
#DIM REF ITEMS
ITEMS:0 = 9
RETURNF ITEMS:0
@OMITTED
#FUNCTION
FLAG:7 = 1
CALLSTR "TAKES(REPLACE(\"a\", \"a\", \"b\",,))"
FLAG:8 = 99
RETURNF 1
