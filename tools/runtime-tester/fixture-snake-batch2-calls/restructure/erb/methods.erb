RETURN

@PROBE_DYNAMIC_NATIVE_NO_STATIC_IMPORT
CALLSTR "TAKE(ABS(-7))"
RESULT:10 = RESULT:11
CALLSTR "TAKE(MAX(2, 9, 4))"
RESULT:12 = RESULT:11
CALLSTR "TAKES(SUBSTRING(\"abcd\", 1))"
RESULTS:10 '= RESULTS:11
FLAG:9 = 1
RETURN

