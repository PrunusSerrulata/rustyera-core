@PROBE_HOST_CHECK_BARSTR
FLAG:0 = 1
LOCALS '= "%BARSTR(HOST_SIDE(), 0, 4)%"
RESULT:10 = STRFORMCHECK(LOCALS)
FLAG:9 = 1
RETURN

@PROBE_HOST_CHECK_VARSIZE_NORMAL_NULL
FLAG:0 = 1
LOCALS '= "{VARSIZE(\"FLAG\")}|{VARSIZE(\"FLAG\",,)}"
RESULT:10 = STRFORMCHECK(LOCALS)
RESULTS:10 '= STRFORM(LOCALS)
FLAG:9 = 1
RETURN

@PROBE_HOST_CHECK_CALLTEXT_VARSIZE_NULL
FLAG:0 = 1
LOCALS '= "{HOST_CALLTEXT_NULL()}"
RESULT:10 = STRFORMCHECK(LOCALS)
FLAG:9 = 1
RETURN

@HOST_SIDE
#FUNCTION
FLAG:8 += 1
RETURNF 1

@HOST_CALLTEXT_NULL
#FUNCTION
FLAG:8 += 1
CALLSTR "HOST_TAKE(VARSIZE(\"FLAG\",,))"
FLAG:8 += 10
RETURNF 1

@HOST_TAKE(ARG)
FLAG:2 = 1
RESULT:11 = ARG
RETURN
