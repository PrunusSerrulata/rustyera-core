; Integer/String and existing whole-array REF only. No SQL or new language ABI.
@METHOD_RESET
METHOD_TRACE = 0
METHOD_BODY_COUNT = 0
METHOD_INDEX_COUNT = 0
METHOD_EVENT_COUNT = 0
METHOD_VALUES:0 = 10
METHOD_VALUES:1 = 20
METHOD_VALUES:2 = 30
METHOD_WORDS:0 '= "initial"
METHOD_WORDS:1 '= "unchanged"
RETURN

@METHOD_NAME(ARGS)
#FUNCTIONS
METHOD_TRACE = METHOD_TRACE * 10 + 1
RETURNF ARGS

@METHOD_ARG(ARG)
#FUNCTION
METHOD_TRACE = METHOD_TRACE * 10 + ARG
RETURNF ARG

@METHOD_STRING_ARG
#FUNCTIONS
METHOD_TRACE = METHOD_TRACE * 10 + 3
RETURNF "wrong-type"

@METHOD_FALLBACK
#FUNCTION
METHOD_TRACE = METHOD_TRACE * 10 + 9
RETURNF 90

@METHOD_FALLBACKS
#FUNCTIONS
METHOD_TRACE = METHOD_TRACE * 10 + 9
RETURNF "fallback"

@METHOD_PAIR(LEFT, RIGHT)
#FUNCTION
#DIM DYNAMIC LEFT
#DIM DYNAMIC RIGHT
METHOD_TRACE = METHOD_TRACE * 10 + 4
METHOD_BODY_COUNT += 1
RETURNF LEFT * 10 + RIGHT

@METHOD_ECHO(ARG)
#FUNCTION
METHOD_BODY_COUNT += 1
RETURNF ARG

@METHOD_REQUIRED(METHOD_REQUIRED_VALUE)
#FUNCTION
METHOD_BODY_COUNT += 1
RETURNF METHOD_REQUIRED_VALUE

@METHOD_TEXT(ARG)
#FUNCTIONS
METHOD_TRACE = METHOD_TRACE * 10 + 4
METHOD_BODY_COUNT += 1
RETURNF @"text:{ARG}"

@METHOD_ZERO
#FUNCTION
METHOD_BODY_COUNT += 1
RETURNF 42

@METHOD_ZEROS
#FUNCTIONS
METHOD_BODY_COUNT += 1
RETURNF "zero"

@METHOD_DEFAULT(LEFT = 5, RIGHT = 6)
#FUNCTION
#DIM DYNAMIC LEFT
#DIM DYNAMIC RIGHT
METHOD_BODY_COUNT += 1
RETURNF LEFT * 10 + RIGHT

@METHOD_ORDINARY(ARG)
METHOD_BODY_COUNT += 1
RETURN ARG

@METHOD_REF(NUMBERS, TEXTS)
#FUNCTION
#DIM REF NUMBERS
#DIMS REF TEXTS
METHOD_BODY_COUNT += 1
NUMBERS:0 += 1
TEXTS:1 '= "changed"
RETURNF NUMBERS:0

@METHOD_REF_INT(NUMBERS)
#FUNCTION
#DIM REF NUMBERS
METHOD_BODY_COUNT += 1
NUMBERS:0 += 1
RETURNF NUMBERS:0

@METHOD_INDEX
#FUNCTION
METHOD_INDEX_COUNT += 1
RETURNF 2

@METHOD_MUTATE_VALUE
#FUNCTION
METHOD_VALUES:0 = 99
RETURNF 2

@METHOD_RECURSE(DEPTH)
#FUNCTION
#DIM DYNAMIC DEPTH
METHOD_BODY_COUNT += 1
IF DEPTH == 0
    RETURNF 1
ENDIF
RETURNF GETMETH("METHOD_RECURSE", , DEPTH - 1) + 1

@EVENTFIRST
METHOD_EVENT_COUNT += 1
RETURN

; Match the dynamic-name call shapes used by qol_graph_init.ERB; no graph/SQL work.
@CAN_MOVE_FOR_GRAPH(MAPID, L_SOURCE, DEST)
#FUNCTION
#DIM DYNAMIC MAPID
#DIM DYNAMIC L_SOURCE
#DIM DYNAMIC DEST
RETURNF GETMETH(@"CAN_MOVE_{MAPID}", 0, L_SOURCE, DEST)

@CAN_MOVE_7(L_SOURCE, DEST)
#FUNCTION
#DIM DYNAMIC L_SOURCE
#DIM DYNAMIC DEST
METHOD_BODY_COUNT += 1
RETURNF (L_SOURCE == 10 && DEST == 11) * 3

@ODEKAKEMAP_SETTING_FOR_GRAPH(MAPID, PLACE_ID, ARGS)
#FUNCTION
#DIM DYNAMIC MAPID
#DIM DYNAMIC PLACE_ID
RETURNF GETMETH(@"ODEKAKEMAP_SETTING_{MAPID}", 0, PLACE_ID, ARGS)

@ODEKAKEMAP_SETTING_7(PLACE_ID, ARGS)
#FUNCTION
#DIM DYNAMIC PLACE_ID
METHOD_BODY_COUNT += 1
RETURNF (PLACE_ID == 11 && ARGS == "reachable")

@METHOD_GRAPH_TEXT(CHARA_A, CHARA_B)
#FUNCTIONS
#DIM DYNAMIC CHARA_A
#DIM DYNAMIC CHARA_B
#DIMS DYNAMIC VERSION
VERSION '= "FIXTURE"
RETURNF GETMETHS(@"SCOM_DIFF_%VERSION%_{CHARA_A}_{CHARA_B}", "", CHARA_A, CHARA_B)

@SCOM_DIFF_FIXTURE_10_11(CHARA_A, CHARA_B)
#FUNCTIONS
#DIM DYNAMIC CHARA_A
#DIM DYNAMIC CHARA_B
METHOD_BODY_COUNT += 1
RETURNF @"pair:{CHARA_A}:{CHARA_B}"

@METHOD_CASE_INTEGER
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_ZERO")
RETURN RESULT:0

@METHOD_CASE_STRING
CALL METHOD_RESET
RESULTS:0 '= GETMETHS("METHOD_ZEROS")
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_PRESENT_SKIPS_FALLBACK
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_PAIR"), METHOD_FALLBACK(), METHOD_ARG(2), METHOD_ARG(3))
RETURN RESULT:0

@METHOD_CASE_MISSING_ONLY_FALLBACK
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_MISSING"), METHOD_FALLBACK(), METHOD_ARG(2), METHOD_ARG(3))
RETURN RESULT:0

@METHOD_CASE_STRING_PRESENT_SKIPS_FALLBACK
CALL METHOD_RESET
RESULTS:0 '= GETMETHS(METHOD_NAME("METHOD_TEXT"), METHOD_FALLBACKS(), METHOD_ARG(2))
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_STRING_MISSING_ONLY_FALLBACK
CALL METHOD_RESET
RESULTS:0 '= GETMETHS(METHOD_NAME("METHOD_MISSING"), METHOD_FALLBACKS(), METHOD_ARG(2))
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_MISSING_NO_FALLBACK
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_MISSING"))
RETURN RESULT:0

@METHOD_CASE_MISSING_OMITTED_FALLBACK
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_MISSING"), , METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_ORDINARY_FUNCTION
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_ORDINARY"), METHOD_FALLBACK(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_WRONG_INTEGER_RETURN
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_TEXT"), METHOD_FALLBACK(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_WRONG_STRING_RETURN
CALL METHOD_RESET
RESULTS:0 '= GETMETHS(METHOD_NAME("METHOD_ECHO"), METHOD_FALLBACKS(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_WRONG_ARGUMENT_TYPE
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_ECHO"), METHOD_FALLBACK(), METHOD_STRING_ARG())
RETURN RESULT:0

@METHOD_CASE_MISSING_REQUIRED_ARGUMENT
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_REQUIRED"), METHOD_FALLBACK())
RETURN RESULT:0

@METHOD_CASE_MISSING_REF
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_REF_INT"), METHOD_FALLBACK())
RETURN RESULT:0

@METHOD_CASE_EXPRESSION_NOT_REF
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_REF_INT"), METHOD_FALLBACK(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_WRONG_REF_TYPE
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_REF_INT"), METHOD_FALLBACK(), METHOD_WORDS:METHOD_INDEX())
RETURN RESULT:0

@METHOD_CASE_WRONG_REF_RANK
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_REF_INT"), METHOD_FALLBACK(), METHOD_MATRIX:METHOD_INDEX():0)
RETURN RESULT:0

@METHOD_CASE_EXPLICIT_OMITTED_SLOT
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_DEFAULT", , , 7)
RETURN RESULT:0

@METHOD_CASE_TRAILING_DEFAULTS
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_DEFAULT")
RETURN RESULT:0

@METHOD_CASE_I64_MIN_IS_VALUE
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_ECHO", , (-9223372036854775807 - 1))
RETURN RESULT:0

@METHOD_CASE_WHOLE_ARRAY_REF_WRITEBACK
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_REF", , METHOD_VALUES, METHOD_WORDS)
RETURN RESULT:0

@METHOD_CASE_WHOLE_ARRAY_REF_SKIPS_INDEX
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_REF", , METHOD_VALUES:METHOD_INDEX(), METHOD_WORDS:METHOD_INDEX())
RETURN RESULT:0

@METHOD_CASE_EXIST_ZERO_ARGUMENT_RESOLUTION
CALL METHOD_RESET
RESULT:0 = EXISTMETH("METHOD_ZERO")
RESULT:1 = EXISTMETH("METHOD_ZEROS")
RESULT:2 = EXISTMETH("METHOD_MISSING")
RESULT:3 = EXISTMETH("METHOD_ORDINARY")
RESULT:4 = EXISTMETH("METHOD_REQUIRED")
RESULT:5 = EXISTMETH("METHOD_DEFAULT")
RESULT:6 = EXISTMETH("METHOD_REF_INT")
RESULT:7 = EXISTMETH("ABS")
RESULT:8 = EXISTMETH("EVENTFIRST")
RETURN RESULT:0

@METHOD_CASE_EVENT_INVISIBLE
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("EVENTFIRST"), METHOD_FALLBACK(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_BUILTIN_INVISIBLE
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("ABS"), METHOD_FALLBACK(), METHOD_ARG(2))
RETURN RESULT:0

@METHOD_CASE_EXTRA_ARGUMENT_POLICY
CALL METHOD_RESET
RESULT:0 = GETMETH(METHOD_NAME("METHOD_ECHO"), METHOD_FALLBACK(), METHOD_ARG(2), METHOD_ARG(3))
RETURN RESULT:0

@METHOD_CASE_FINITE_RECURSION
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_RECURSE", , 3)
RETURN RESULT:0

@METHOD_CASE_VALUE_CAPTURED_BEFORE_NEXT_ARGUMENT
CALL METHOD_RESET
RESULT:0 = GETMETH("METHOD_PAIR", , METHOD_VALUES:0, METHOD_MUTATE_VALUE())
RETURN RESULT:0

@METHOD_CASE_CAN_MOVE_DYNAMIC_PATTERN
CALL METHOD_RESET
RESULT:0 = CAN_MOVE_FOR_GRAPH(7, 10, 11)
RESULT:1 = CAN_MOVE_FOR_GRAPH(8, 10, 11)
RETURN RESULT:0

@METHOD_CASE_ODEKAKEMAP_DYNAMIC_PATTERN
CALL METHOD_RESET
RESULT:0 = ODEKAKEMAP_SETTING_FOR_GRAPH(7, 11, "reachable")
RESULT:1 = ODEKAKEMAP_SETTING_FOR_GRAPH(8, 11, "reachable")
RETURN RESULT:0

@METHOD_CASE_STRING_DYNAMIC_PATTERN
CALL METHOD_RESET
RESULTS:0 '= METHOD_GRAPH_TEXT(10, 11)
RESULTS:1 '= METHOD_GRAPH_TEXT(10, 12)
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_FORMATTED_EXPRESSION
CALL METHOD_RESET
RESULTS:0 '= @"value={GETMETH(@"METHOD_%METHOD_NAME("ZERO")%", METHOD_FALLBACK())}"
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_STRFORM_RUNTIME_EXPRESSION
CALL METHOD_RESET
RESULTS:0 '= STRFORM("value={GETMETH(\"METHOD_ZERO\", METHOD_FALLBACK())}")
RESULT:0 = 0
RETURN RESULT:0

@METHOD_CASE_INTEGER_STATEMENT
CALL METHOD_RESET
GETMETH "METHOD_ZERO", METHOD_FALLBACK()
RETURN RESULT:0

@METHOD_CASE_STRING_STATEMENT
CALL METHOD_RESET
GETMETHS "METHOD_ZEROS", METHOD_FALLBACKS()
RETURN
