@B2C_BIT_BOUNDARIES
B2C_BITS:0 = 0
B2C_BITS:1 = 0
RESULT:10 = BITSET(B2C_BITS, 63, , 2)
RESULT:11 = B2C_BITS:0
RESULT:12 = B2C_BITS:1
RESULT:13 = BITGET(B2C_BITS, 63)
BITTOGGLE B2C_BITS, 64
RESULT:14 = RESULT
RESULT:15 = BITGET(B2C_BITS, 64)
RESULT:16 = BITGET(B2C_BITS, 128)
RESULT:17 = BITTOGGLE(B2C_BITS, -1)
RESULT:18 = BITINDEXOFFIRST(B2C_BITS, 1)
RESULT:19 = BITINDEXOFFIRST(B2C_BITS)
RESULT:20 = BITSET(B2C_BITS, -2, 1, 0)
RESULT:21 = BITSET(B2C_BITS, -1, 1, 2)
RESULT:22 = BITGET(B2C_BITS, 0)
RETURN

