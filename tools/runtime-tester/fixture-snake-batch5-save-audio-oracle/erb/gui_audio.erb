@B5_GUI_AUDIO
B5_REPORT '= "invalid_get=" + TOSTR(GETSOUNDORBGMINFO(-2)) + ",invalid_is=" + TOSTR(ISPLAYINGSOUND(-1)) + ",invalid_control=" + TOSTR(SOUNDCONTROL(-1, 0))
B5_REPORT += UNICODE(13) + UNICODE(10) + "invalid_action=" + TOSTR(SOUNDCONTROL(0, 9))
SETSOUNDVOLUME 37
PLAYSOUND "batch5-long.wav", 3
AWAIT 300
B5_REPORT += UNICODE(13) + UNICODE(10) + "playing=" + TOSTR(ISPLAYINGSOUND(0)) + ",sound_play_duration=" + TOSTR(GETSOUNDORBGMINFO(0, 1)) + ",sound_play_position=" + TOSTR(GETSOUNDORBGMINFO(0, 2)) + ",volume=" + TOSTR(GETSOUNDORBGMINFO(0, 4))
B5_DUMMY = GETSOUNDORBGMINFO(0)
B5_REPORT += UNICODE(13) + UNICODE(10) + "omitted=" + TOSTR(B5_DUMMY) + ",r0=" + TOSTR(RESULT:0) + ",r1=" + TOSTR(RESULT:1) + ",r2=" + TOSTR(RESULT:2) + ",r3=" + TOSTR(RESULT:3) + ",r4=" + TOSTR(RESULT:4)
B5_DUMMY = SOUNDCONTROL(0, 0)
B5_REPORT += UNICODE(13) + UNICODE(10) + "pause_ret=" + TOSTR(B5_DUMMY)
B5_DUMMY = GETSOUNDORBGMINFO(0, 2)
AWAIT 350
B5_REPORT += UNICODE(13) + UNICODE(10) + "paused_is=" + TOSTR(ISPLAYINGSOUND(0)) + ",pause_pos_a=" + TOSTR(B5_DUMMY) + ",pause_pos_b=" + TOSTR(GETSOUNDORBGMINFO(0, 2))
B5_DUMMY = SOUNDCONTROL(0, 1)
B5_REPORT += UNICODE(13) + UNICODE(10) + "resume_ret=" + TOSTR(B5_DUMMY)
AWAIT 300
B5_REPORT += UNICODE(13) + UNICODE(10) + "resumed_is=" + TOSTR(ISPLAYINGSOUND(0)) + ",resume_pos=" + TOSTR(GETSOUNDORBGMINFO(0, 2))
B5_REPORT += UNICODE(13) + UNICODE(10) + "rate_omitted=" + TOSTR(SOUNDCONTROL(0, 3, 250)) + ",speed=" + TOSTR(GETSOUNDORBGMINFO(0, 5)) + ",pitch_zero=" + TOSTR(SOUNDCONTROL(0, 3, 250, 0)) + ",pitch_nonzero=" + TOSTR(SOUNDCONTROL(0, 3, 250, 1))
B5_DUMMY = SOUNDCONTROL(0, 3, 1)
B5_REPORT += UNICODE(13) + UNICODE(10) + "speed_low=" + TOSTR(GETSOUNDORBGMINFO(0, 5))
B5_DUMMY = SOUNDCONTROL(0, 3, 2000)
B5_REPORT += UNICODE(13) + UNICODE(10) + "speed_high=" + TOSTR(GETSOUNDORBGMINFO(0, 5))
B5_DUMMY = SOUNDCONTROL(0, 2)
B5_REPORT += UNICODE(13) + UNICODE(10) + "stop_ret=" + TOSTR(B5_DUMMY) + ",stopped=" + TOSTR(ISPLAYINGSOUND(0)) + ",stopped_duration=" + TOSTR(GETSOUNDORBGMINFO(0, 1)) + ",stopped_position=" + TOSTR(GETSOUNDORBGMINFO(0, 2))
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
PLAYSOUND "batch5-long.wav", 3
B5_REPORT += UNICODE(13) + UNICODE(10) + "channels=" + TOSTR(ISPLAYINGSOUND(0)) + "," + TOSTR(ISPLAYINGSOUND(1)) + "," + TOSTR(ISPLAYINGSOUND(2)) + "," + TOSTR(ISPLAYINGSOUND(3)) + "," + TOSTR(ISPLAYINGSOUND(4)) + "," + TOSTR(ISPLAYINGSOUND(5)) + "," + TOSTR(ISPLAYINGSOUND(6)) + "," + TOSTR(ISPLAYINGSOUND(7)) + "," + TOSTR(ISPLAYINGSOUND(8)) + "," + TOSTR(ISPLAYINGSOUND(9))
PLAYSOUND "batch5-short.wav", 2
B5_REPORT += UNICODE(13) + UNICODE(10) + "all_busy_overwrite_0_duration=" + TOSTR(GETSOUNDORBGMINFO(0, 1))
B5_DUMMY = SOUNDCONTROL(3, 0)
PLAYSOUND "batch5-short.wav", 2
B5_REPORT += UNICODE(13) + UNICODE(10) + "paused_reused_3_duration=" + TOSTR(GETSOUNDORBGMINFO(3, 1))
PLAYBGM "batch5-long.wav"
AWAIT 250
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_playing=" + TOSTR(ISPLAYINGBGM()) + ",bgm_duration=" + TOSTR(GETSOUNDORBGMINFO(-1, 1))
B5_DUMMY = BGMCONTROL(0)
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_pause_ret=" + TOSTR(B5_DUMMY)
B5_DUMMY = GETSOUNDORBGMINFO(-1, 2)
AWAIT 300
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_paused=" + TOSTR(ISPLAYINGBGM()) + ",pos_a=" + TOSTR(B5_DUMMY) + ",pos_b=" + TOSTR(GETSOUNDORBGMINFO(-1, 2))
B5_DUMMY = BGMCONTROL(1)
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_resume_ret=" + TOSTR(B5_DUMMY)
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_rate_omitted=" + TOSTR(BGMCONTROL(3, 250)) + ",bgm_pitch_zero=" + TOSTR(BGMCONTROL(3, 250, 0)) + ",bgm_pitch_nonzero=" + TOSTR(BGMCONTROL(3, 250, 1)) + ",bgm_resumed=" + TOSTR(ISPLAYINGBGM()) + ",bgm_speed=" + TOSTR(GETSOUNDORBGMINFO(-1, 5))
B5_DUMMY = BGMCONTROL(2)
B5_REPORT += UNICODE(13) + UNICODE(10) + "bgm_stop_ret=" + TOSTR(B5_DUMMY) + ",bgm_stopped=" + TOSTR(ISPLAYINGBGM())
RESULT = SAVETEXT(B5_REPORT, "batch5-gui-result.txt", 0, 1)
IF RESULT == 0
    THROW batch5 GUI result write failed
ENDIF
PRINTFORML gui_write_ret={RESULT}
PRINTL BATCH5_GUI_DONE
AWAIT 4500
FORCE_QUIT
