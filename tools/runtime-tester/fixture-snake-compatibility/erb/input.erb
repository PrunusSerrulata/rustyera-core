@COMPAT_SEQUENCE_MACRO
RESULT = SEQUENCEINPUT("21")
INPUT
RESULT:0 = RESULT
RESULT = DISABLE_INPUT_MACRO()
RESULT = SEQUENCEINPUT("literal\n@CONFIG(1)*2\e")
INPUTS
SAVESTR:0 '= RESULTS
RESULT = ENABLE_INPUT_MACRO()
RETURN RESULT:0

@COMPAT_NF_ENVIRONMENT
RESULT:0 = GETPLATFORM()
RESULT:1 = ENV_HAS_CAPABILITY("input.timed_viewport")
RESULT:2 = ENV_HAS_CAPABILITY("input.device_latch")
TINPUTSNF 2000, "UPDATE", 0, ""
RETURN RESULT:0
