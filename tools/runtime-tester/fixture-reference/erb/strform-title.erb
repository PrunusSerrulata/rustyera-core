; Authoritative archive-003422 regression. CHARA_TITLE.xml is copied byte-for-byte
; from eraFL. The function keeps CHARA_TITLE.ERB line 30 and the real
; IS_UNIQUE_CHARA body; only the post-condition title-unlock work is omitted.
@ORACLE_STRFORM_TITLE
LOADTEXT "XML/CHARA_TITLE.xml"
XML_DOCUMENT XMLID_CHARA_TITLE, RESULTS
REPEAT 29 - CHARANUM
    ADDVOIDCHARA
REND
NO:28 = 28
MASTER = 0
CALL CHARA_TITLE_CEHCK_UNLOCK_TITLE(28)
RESULT:80 = RESULT
SIF RESULT:80
    RESULTS:80 '= "1"
SIF !RESULT:80
    RESULTS:80 '= "0"
CALL CHARA_TITLE_CEHCK_UNLOCK_TITLE(0)
RESULT:81 = RESULT
SIF RESULT:81
    RESULTS:81 '= "1"
SIF !RESULT:81
    RESULTS:81 '= "0"
CHARA_TITLE_UNLOCK_FLAG:MASTER:40 = 0
CALL ORACLE_STRFORM_TITLE_MERCHANT_REQUIREMENT(40, 149)
RESULT:82 = RESULT
CHARA_TITLE_UNLOCK_FLAG:MASTER:40 = 0
CALL ORACLE_STRFORM_TITLE_MERCHANT_REQUIREMENT(40, 150)
RESULT:83 = RESULT
CHARA_TITLE_UNLOCK_FLAG:MASTER:41 = 0
CALL ORACLE_STRFORM_TITLE_MERCHANT_REQUIREMENT(41, 299)
RESULT:84 = RESULT
CHARA_TITLE_UNLOCK_FLAG:MASTER:41 = 0
CALL ORACLE_STRFORM_TITLE_MERCHANT_REQUIREMENT(41, 300)
RESULT:85 = RESULT
RETURN

@ORACLE_STRFORM_TITLE_FOR_CHARA(CHARA_ID)
#DIM CHARA_ID
CALL CHARA_TITLE_CEHCK_UNLOCK_TITLE(CHARA_ID)
RETURN RESULT

; Copied from ERB/SYSTEM/CHARA_TITLE/CHARA_TITLE.ERB. The XPath is narrowed to
; title 1 so this focused fixture does not need unrelated title requirement functions.
@CHARA_TITLE_CEHCK_UNLOCK_TITLE(CHARA_ID)
#DIM  CHARA_ID
#DIMS DYNAMIC TITLE_ACTIVATE_CONDITION
#DIM  DYNAMIC ITEM_IDX
#DIM  DYNAMIC ITEM_COUNT
#DIMS DYNAMIC XML_CHARA_TITLES, CHARA_TITLE_MAX_NUM

XML_GET XMLID_CHARA_TITLE, @"//title[@id='1']", XML_CHARA_TITLES, 3
ITEM_COUNT = RESULT

FOR ITEM_IDX, 0, ITEM_COUNT
    TITLE_ACTIVATE_CONDITION '= ""
    XML_GET XML_CHARA_TITLES:ITEM_IDX, @"//activateCondition/@condition", TITLE_ACTIVATE_CONDITION, 1
    IF RESULT > 0
        IF TITLE_ACTIVATE_CONDITION != ""
            IF !TOINT(STRFORM(TITLE_ACTIVATE_CONDITION))
                CONTINUE
            ENDIF
        ENDIF
    ENDIF
    RESULT = 1
    RETURN RESULT
NEXT
RESULT = 0
RETURN RESULT

; Copied from ERB/SYSTEM/FUNCTION/_FUNCTION.ERB.
@IS_UNIQUE_CHARA(ARG:0)
#FUNCTION
RETURNF NO:(ARG:0) < MAX_FIXED_CHARA

; Archive 080505 reaches CHARA_TITLE.ERB lines 61-76 for title 40. The condition
; and unlock branch below are copied from that path; only the outer query is
; narrowed to the faulting title so unrelated requirement functions stay out.
@ORACLE_STRFORM_TITLE_MERCHANT_REQUIREMENT(TITLE_ID, FLAG_VALUE)
#DIM TITLE_ID
#DIM FLAG_VALUE
#DIM CHARA_ID
#DIMS DYNAMIC TITLE_REQCONDITION
#DIMS DYNAMIC XML_CHARA_TITLES, CHARA_TITLE_MAX_NUM
#DIM DYNAMIC ITEM_IDX
#DIM DYNAMIC CAN_UNLOCK_TITLE

CHARA_ID = MASTER
FLAG:領地評判_商業 = FLAG_VALUE
XML_GET XMLID_CHARA_TITLE, @"//title[@id='{TITLE_ID}']", XML_CHARA_TITLES, 3

ITEM_IDX = 0
XML_GET XML_CHARA_TITLES:ITEM_IDX, @"//@id", RESULTS, 1
TITLE_ID = TOINT(RESULTS)

; XMLから条件式を取得
XML_GET XML_CHARA_TITLES:ITEM_IDX, @"//reqCondition/@condition", TITLE_REQCONDITION, 1
IF RESULT > 0
    ;条件関数の実行
    IF !CHARA_TITLE_UNLOCK_FLAG:CHARA_ID:TITLE_ID
        IF !TOINT(STRFORM(TITLE_REQCONDITION))
            CAN_UNLOCK_TITLE = 0
        ELSE
            CAN_UNLOCK_TITLE = 1
        ENDIF
    ENDIF
ENDIF

IF CAN_UNLOCK_TITLE
    CHARA_TITLE_UNLOCK_FLAG:CHARA_ID:TITLE_ID = 1
ENDIF
RETURN CAN_UNLOCK_TITLE
