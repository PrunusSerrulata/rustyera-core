; Regression extracted from eraFL's SHOW_INFO_SHOW_CHARA_TITLE_BONUS path.
; The XML nodes live in the sibling fixture and REPLACE_TAGGED_VALUE is copied
; from ERB/SKILLS/FUNCTIONS_SKILL.ERB without changing its replacement syntax.
@ORACLE_ERAFL_TITLE_BONUS_TOOLTIP
LOADTEXT "XML/CHARA_TITLE_BONUS_TOOLTIP.xml"
XML_DOCUMENT XMLID_CHARA_TITLE_BONUS, RESULTS
RESULTS:90 = %ORACLE_TITLE_BONUS_TOOLTIP("STATUS_BONUS_ADD_CRT_1")%
RESULTS:91 = %ORACLE_TITLE_BONUS_TOOLTIP("STATUS_BONUS_ADD_CRT_2")%
RESULTS:92 = %ORACLE_TITLE_BONUS_TOOLTIP("MAG_MASTERY_1")%
ORACLE_REPLACE_ITEMS:0 = x
ORACLE_REPLACE_ITEMS:1 = y
RESULTS:93 = %REPLACE("A1 B2 C3", "\\d", ORACLE_REPLACE_ITEMS, 1)%
RESULTS:94 = %REPLACE("a+b", "+", "-", 2)%
RETURN

@ORACLE_TITLE_BONUS_TOOLTIP(DEFNAME)
#FUNCTIONS
#DIMS DEFNAME
#DIMS XML
#DIMS DESC

XML_GET XMLID_CHARA_TITLE_BONUS, @"//titleBonus[@defname='%DEFNAME%']", XML, 3
XML_GET XML, "//description", DESC, 1
DESC = %REPLACE_TAGGED_VALUE(DESC, XML)%
RETURNF STRIP_WHITESPACE(DESC)

; Copied from ERB/SKILLS/FUNCTIONS_SKILL.ERB.
@REPLACE_TAGGED_VALUE(TEXT, _XML, SKILL_LV = 1)
#FUNCTIONS
#DIMS TEXT
#DIMS _XML
#DIM  SKILL_LV
#DIM  TAG_COUNT
#DIMS DISP_ID_NAME, MAX_MODIFIER_PER_SKILL

TAG_COUNT = XML_GET(_XML, @"//value/@dispIdName", DISP_ID_NAME, 1)
FOR LOCAL, 0, TAG_COUNT
    IF XML_GET(_XML, @"//value[@dispIdName = '%DISP_ID_NAME:LOCAL%']/li[{SKILL_LV}]", RESULTS, 1) == 0
        XML_GET _XML, @"//value[@dispIdName = '%DISP_ID_NAME:LOCAL%']/li[1]", RESULTS, 1
    ENDIF
    TEXT = %REPLACE(TEXT, @"\\[\\$VALUE:%DISP_ID_NAME:LOCAL%\\]", @"%RESULTS%")%
NEXT
RETURNF TEXT

; Copied from ERB/SYSTEM/FUNCTION/文字列操作.ERB.
@STRIP_WHITESPACE(TEXT)
#FUNCTIONS
#DIMS TEXT
RETURNF REPLACE(TEXT, "[\t\n]", "")
