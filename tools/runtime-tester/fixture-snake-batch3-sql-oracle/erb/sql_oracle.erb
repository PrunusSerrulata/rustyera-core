RETURN

@SQL_ORACLE_PARAMETERIZED_READER
#LOCALSIZE 1
SQL_CONNECT "preader"
LOCAL = SQL_P_EXECUTE_READER("preader", "SELECT @2, @1, @0", "zero", , "two")
RESULT:0 = SQL_READER_READ(LOCAL)
RESULTS:0 '= SQL_READER_GET_STRING(LOCAL, 0)
RESULT:1 = SQL_READER_ISNULL(LOCAL, 1)
RESULTS:1 '= SQL_READER_GET_STRING(LOCAL, 1)
RESULTS:2 '= SQL_READER_GET_STRING(LOCAL, 2)
RESULT:2 = SQL_READER_READ(LOCAL)
RESULT:3 = SQL_READER_CLOSE(LOCAL)
RETURN

