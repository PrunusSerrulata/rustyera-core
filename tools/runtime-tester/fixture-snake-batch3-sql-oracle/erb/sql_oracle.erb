RESULT:3 = SQL_CONNECT("MAIN")
RESULT:4 = SQL_CONNECT("main", "Data Source=plugins/conflict.db")
RESULT:5 = SQL_EXECUTE_NONQUERY("MAIN", "BEGIN")
RESULT:6 = SQL_P_EXECUTE_NONQUERY("main", "INSERT INTO tx (id, value) VALUES (@0, @1)", "1", "rolled-back")
RESULT:7 = SQL_EXECUTE_NONQUERY("main", "ROLLBACK")
RESULT:8 = SQL_EXECUTE_SCALAR_LONG("main", "SELECT COUNT(*) FROM tx")
RESULT:9 = SQL_EXECUTE_NONQUERY("main", "BEGIN")
