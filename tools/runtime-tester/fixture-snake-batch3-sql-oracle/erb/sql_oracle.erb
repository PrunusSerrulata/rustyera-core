@SQL_ORACLE_SCALAR_AND_PARAMETERS
SQL_CONNECT "scalar"
RESULT:0 = SQL_EXECUTE_SCALAR_LONG("scalar", "SELECT NULL")
RESULTS:0 '= SQL_EXECUTE_SCALAR_STRING("scalar", "SELECT NULL")
RESULT:1 = SQL_EXECUTE_SCALAR_LONG("scalar", "SELECT 7 WHERE 0")
RESULTS:1 '= SQL_EXECUTE_SCALAR_STRING("scalar", "SELECT 'missing' WHERE 0")
RESULT:2 = SQL_EXECUTE_SCALAR_LONG("scalar", "SELECT '42'")
RESULTS:2 '= SQL_EXECUTE_SCALAR_STRING("scalar", "SELECT 42")
SQL_EXECUTE_NONQUERY "scalar", "CREATE TABLE params (a, b, c)"
RESULT:3 = SQL_P_EXECUTE_NONQUERY("scalar", "INSERT INTO params VALUES (@0, @1, @2)", "alpha", , "omega")
RESULTS:3 '= SQL_EXECUTE_SCALAR_STRING("scalar", "SELECT a || '|' || COALESCE(b, '<null>') || '|' || c || '|' || typeof(a) || '|' || typeof(b) || '|' || typeof(c) FROM params")
RESULTS:4 '= SQL_P_EXECUTE_SCALAR_STRING("scalar", "SELECT @2 || '|' || COALESCE(@1, '<null>') || '|' || @0", "zero", , "two")
RESULT:4 = SQL_P_EXECUTE_SCALAR_LONG("scalar", "SELECT @0 IS NULL", ,)
RETURN

@SQL_ORACLE_READER_LIFECYCLE
#LOCALSIZE 1
SQL_CONNECT "reader"
SQL_EXECUTE_NONQUERY "reader", "CREATE TABLE rows (n INTEGER, s TEXT, z)"
SQL_EXECUTE_NONQUERY "reader", "INSERT INTO rows VALUES (7, 'seven', NULL), (8, 'eight', 'value')"
LOCAL = SQL_EXECUTE_READER("reader", "SELECT n, s, z FROM rows ORDER BY n")
RESULT:0 = SQL_READER_READ(LOCAL)
RESULT:1 = SQL_READER_GET_LONG(LOCAL, 0)
RESULTS:0 '= SQL_READER_GET_STRING(LOCAL, 1)
RESULT:2 = SQL_READER_ISNULL(LOCAL, 2)
RESULT:3 = SQL_READER_GET_LONG(LOCAL, 2)
RESULTS:1 '= SQL_READER_GET_STRING(LOCAL, 2)
RESULT:4 = SQL_READER_READ(LOCAL)
RESULT:5 = SQL_READER_GET_LONG(LOCAL, 0)
RESULTS:2 '= SQL_READER_GET_STRING(LOCAL, 1)
RESULT:6 = SQL_READER_ISNULL(LOCAL, 2)
RESULT:7 = SQL_READER_READ(LOCAL)
RESULT:8 = SQL_READER_READ(LOCAL)
RESULT:9 = SQL_READER_CLOSE(LOCAL)
RESULT:10 = SQL_READER_CLOSE(LOCAL)
RESULT:11 = SQL_READER_READ(LOCAL)
RESULT:12 = SQL_READER_READ(999999)
RESULT:13 = SQL_READER_CLOSE(999999)
RETURN

@SQL_ORACLE_READER_CONVERSIONS
