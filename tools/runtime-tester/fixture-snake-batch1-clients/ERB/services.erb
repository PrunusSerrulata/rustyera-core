@S04_HTML
PRINTL SNAKE_HTML_BEFORE_QUERY
FLAG:90 = 0
FLAG:91 = 0
RESULT:50 = HTML_STRINGLEN("", 1)
RESULT:51 = HTML_STRINGLINES("", S04_WIDTH())
RESULT:52 = FLAG:91
RESULT:53 = HTML_STRINGLEN("<b>A</b>", S04_FLAG())
RESULT:54 = FLAG:90
RESULT:55 = HTML_STRINGLEN("A<br>AAAA", 1)
RESULT:56 = HTML_STRINGLEN("A", 1)
RESULT:57 = RESULT:55 == RESULT:56
RESULT:58 = HTML_STRINGLINES("AAAA", S04_WIDTH())
RESULT:59 = FLAG:91 == RESULT:58
RESULTS:50 '= HTML_SUBSTRING("<b>A中😀</b>", 3)
RESULTS:51 '= RESULTS:1
RESULTS:52 '= HTML_TOPLAINTEXT(RESULTS:50) + HTML_TOPLAINTEXT(RESULTS:51)
RESULT:60 = RESULTS:52 == "A中😀"
RESULT:61 = HTML_STRINGLEN("fi é　中😀", 1)
RESULT:62 = HTML_STRINGLEN("<font color='red'><i>fi</i></font>", 1)
RESULT:63 = HTML_STRINGLEN("<shape type='space' param='100'>", 1)
PRINTFORML SNAKE_HTML={RESULT:50}/{RESULT:51}/{RESULT:52}/{RESULT:54}/{RESULT:57}/{RESULT:59}/{RESULT:60}
PRINTFORML SNAKE_HTML_METRICS={RESULT:53}/{RESULT:55}/{RESULT:58}/{RESULT:61}/{RESULT:62}/{RESULT:63}
RETURN

@S04_FLAG
#FUNCTION
FLAG:90 += 1
RETURNF 1

@S04_WIDTH
#FUNCTION
FLAG:91 += 1
IF FLAG:91 == 1
    RETURNF 1
ENDIF
RETURNF 2

