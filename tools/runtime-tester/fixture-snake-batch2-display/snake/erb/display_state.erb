@PROBE_TIMER
RESULT = 77
FLAG:5 = 3
SETANIMETIMER FLAG:5 + 1
FLAG:0 = RESULT
FLAG:1 = GETANIMETIMER()
SETANIMETIMER 0
FLAG:2 = GETANIMETIMER()
SETANIMETIMER 32767
FLAG:3 = GETANIMETIMER()
BITMAP_CACHE_ENABLE FLAG:5 - 2
FLAG:4 = RESULT
RETURN

@PROBE_TIMER_INVALID
SETANIMETIMER 20
SETANIMETIMER 32768
RETURN

@PROBE_HISTORY
CLEARLINE LINECOUNT
PRINTL oldest
PRINT pending
RESULTS:0 '= GETDISPLAYLINE(-1)
RESULTS:1 '= GETDISPLAYLINE(-2)
RESULTS:2 '= GETDISPLAYLINE((-9223372036854775807 - 1))
RETURN

@PROBE_TEXT_BACKGROUND
PRINTL eligible
PRINTFORML \s
TEXT_BGC_ON 1122867, 50
RETURN

@PROBE_TEXT_BACKGROUND_OFF
TEXT_BGC_ON 1122867, 50
TEXT_BGC_OFF
RETURN
