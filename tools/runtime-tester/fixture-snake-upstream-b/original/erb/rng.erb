@RAND_VALID
RANDOMIZE 123456
LOCAL = RAND:1000000
LOCAL:1 = RAND(1000000)
LOCAL:2 = RAND(5, 1000000)
RANDOMIZE 123456
RESULT:10 = RAND:1000000 == LOCAL
RESULT:11 = RAND(1000000) == LOCAL:1
RESULT:12 = RAND(5, 1000000) == LOCAL:2
RESULT:13 = RAND(0, 1)
RESULT:14 = RAND((-9223372036854775807 - 1), -9223372036854775807)
LOCAL:3 = 1
RESULT:15 = RAND:(LOCAL:3)
RETURN

@RAND_CLAMP
LOCAL = -1
RANDOMIZE 123456
LOCAL:1 = RAND:1000000
RANDOMIZE 123456
RESULT:10 = RAND:(LOCAL:0)
LOCAL = 0
RESULT:11 = RAND:(LOCAL:0)
RESULT:12 = RAND(-1)
RESULT:13 = RAND(7, 7)
RESULT:14 = RAND(9, 8)
RESULT:15 = RAND(0, 0)
RESULT:16 = RAND:1000000 == LOCAL:1
RETURN

@RAND_FORM
LOCAL = -1
RANDOMIZE 123456
LOCAL:1 = RAND:1000000
RANDOMIZE 123456
RESULTS:10 '= STRFORM("{RAND:(LOCAL:0)}|{RAND(7, 7)}|{RAND(0, 0)}")
RESULTS:11 '= STRFORM("{RAND:(LOCAL:0)}|{RAND(7, 7)}")
RESULT:10 = RAND:1000000 == LOCAL:1
RETURN

@RAND_VARIABLE_INVALID
LOCAL = -1
RESULT:10 = 77
RESULT:10 = RAND:(LOCAL:0)
RETURN

@RAND_FUNCTION_INVALID
RESULT:10 = 77
RESULT:10 = RAND(7, 7)
RETURN
