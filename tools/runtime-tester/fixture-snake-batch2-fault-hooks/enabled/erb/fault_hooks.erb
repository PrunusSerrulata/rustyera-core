@PROBE_BEFORE_THROW
FLAG:0 = 7
FLAG:10 = 1
THROW original-throw
FLAG:0 = 9
RETURN

@PROBE_BEFORE_ERROR
FLAG:0 = 7
FLAG:10 = 2
CALL CAUSE_ERROR
FLAG:0 = 9
RETURN

@PROBE_HOOK_SECONDARY
FLAG:0 = 7
FLAG:10 = 3
CALL CAUSE_ERROR
FLAG:0 = 9
RETURN

@CAUSE_ERROR
#DIM B2D_FAULT_ARRAY, 1
#DIM B2D_FAULT_INDEX
B2D_FAULT_INDEX = -1
B2D_FAULT_ARRAY:B2D_FAULT_INDEX = 0
RETURN

@BEFORE_THROW
IF FLAG:10 == 1
    FLAG:1 += 1
ELSE
    FLAG:9 += 1
ENDIF
RETURN

@BEFORE_ERROR
FLAG:2 += 1
IF FLAG:10 == 3
    CALL CAUSE_ERROR
ENDIF
RETURN
