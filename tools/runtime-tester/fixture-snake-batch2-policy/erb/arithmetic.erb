; Core-owned policy probes. Each oracle request starts from a fresh fixture instance.
@COMPAT_ARITHMETIC(ARG, ARG:1)
RESULT:0 = ARG + ARG:1
RESULT:1 = ARG - ARG:1
RESULT:2 = ARG * ARG:1
RETURN RESULT:0

@COMPAT_DIVIDE(ARG, ARG:1)
RESULT:0 = ARG / ARG:1
RETURN RESULT:0

@COMPAT_MODULO(ARG, ARG:1)
RESULT:0 = ARG % ARG:1
RETURN RESULT:0

@POLICY_MINIMUM_DIVIDE
LOCAL = -9223372036854775807 - 1
FLAG:10 = 777
RESULT:10 = LOCAL / -1
FLAG:10 = 888
RETURN

@POLICY_MINIMUM_MODULO
LOCAL = -9223372036854775807 - 1
FLAG:10 = 777
RESULT:10 = LOCAL % -1
FLAG:10 = 888
RETURN

@POLICY_VARIABLE_NEGATE
LOCAL = -9223372036854775807 - 1
RESULT:10 = -LOCAL
RESULT:11 = 0 - LOCAL
RETURN

@POLICY_POSTFIX
LOCAL = 9223372036854775807
RESULT:10 = LOCAL++
RESULT:11 = LOCAL
LOCAL = -9223372036854775807 - 1
RESULT:12 = LOCAL--
RESULT:13 = LOCAL
RETURN

@POLICY_PREFIX
LOCAL = 9223372036854775807
RESULT:10 = ++LOCAL
RESULT:11 = LOCAL
LOCAL = -9223372036854775807 - 1
RESULT:12 = --LOCAL
RESULT:13 = LOCAL
RETURN

@POLICY_XML_CLONES
LOCALS '= "<root><a/><a/></root>"
RESULT:10 = XML_ADDNODE(LOCALS, "/root/a", "<x/>", 0, 1)
RESULT:11 = XML_GET(LOCALS, "/root/a/x")
RESULTS:10 '= LOCALS
RETURN

@POLICY_STRING_COMPARE
LOCALS '= "a"
LOCALS:1 '= "a"
RESULT:10 = LOCALS >= LOCALS:1
RESULT:11 = LOCALS <= LOCALS:1
LOCALS:1 '= "b"
RESULT:12 = LOCALS >= LOCALS:1
RESULT:13 = LOCALS <= LOCALS:1
RETURN
