@PERF_FRAMES
REPEAT 256
CALLFORM PERF_FRAME_{COUNT % 2}, COUNT
REND
RETURN

@PERF_FRAME_0(ARG)
#DIM LOCAL_VALUE
#DIMS LOCAL_TEXT
LOCAL_VALUE = ARG
LOCAL_TEXT '= @"even-{LOCAL_VALUE}"
PERF_INTS:4095 += LOCAL_VALUE
RETURN

@PERF_FRAME_1(ARG)
#DIM LOCAL_VALUE
#DIMS LOCAL_TEXT
LOCAL_VALUE = ARG
LOCAL_TEXT '= @"odd-{LOCAL_VALUE}"
PERF_INTS:4095 += LOCAL_VALUE
RETURN
