@SYSTEM_TITLE
PRINTL SNAKE_LIFECYCLE_START
INPUT
IF RESULT == 90
    PRINTL SNAKE_LIFECYCLE_DECODE_BEGIN
    RESULT = GCREATEFROMFILE(743, "lifecycle-gate.png")
    RESULT:83 = GGETCOLOR(743, 0, 0)
    PRINTFORML SNAKE_LIFECYCLE_DECODE_COMPLETE={RESULT:83}
    INPUT
    RETURN
ENDIF
RESULT = GCREATE(741, 2, 2)
RESULT = GSETCOLOR(741, 4294901760, 0, 0)
PRINTL SNAKE_LIFECYCLE_DRAWN
RESULT:80 = GGETCOLOR(741, 0, 0)
RESULT = GSETCOLOR(741, 4278190335, 0, 0)
RESULT:81 = GGETCOLOR(741, 0, 0)
PRINTL SNAKE_LIFECYCLE_PRINTED
RESULT:82 = HTML_STRINGLEN("<b>x</b>", 1) > 0
PRINTFORML SNAKE_LIFECYCLE_SERVICES={RESULT:80}/{RESULT:81}/{RESULT:82}
REPEAT 120
    PRINTFORML SNAKE_SCROLL_{COUNT}
REND
PRINTBUTTON "SNAKE_LIFECYCLE_TARGET", 41
PRINTL
PRINTL SNAKE_LIFECYCLE_POINTER_READY
INPUT
REPEAT 6
    ; Remove only the accepted input row so the pointer target does not shift before sampling.
    CLEARLINE 1
    LIFE_X:COUNT = MOUSEX()
    LIFE_Y:COUNT = MOUSEY()
    LIFE_BUTTON:COUNT '= MOUSEB()
    PRINTFORML SNAKE_LIFECYCLE_POINTER_{COUNT}={LIFE_X:COUNT}/{LIFE_Y:COUNT}/%LIFE_BUTTON:COUNT%
    INPUT
REND
PRINTL SNAKE_LIFECYCLE_DONE
INPUT
RETURN
