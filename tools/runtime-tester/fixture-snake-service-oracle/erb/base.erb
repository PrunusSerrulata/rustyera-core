@SYSTEM_TITLE
PRINTL S04_ORACLE_READY
PRINTL Enter case number in a fresh session. Error cases may stop before the completion marker.
PRINTL 1: s04-empty-lazy
PRINTL 2: s04-first-row-half-units
PRINTL 3: s04-lines-width-evaluation
PRINTL 4: s04-substring-explicit-break
PRINTL 5: s04-substring-unicode-cuts
PRINTL 6: s04-entity-measurement
PRINTL 7: s04-substring-amp-error
PRINTL 8: s04-late-parse-error-before-flag
PRINTL 9: s04-substring-lazy-error-frontier
PRINTL 10: s04-style-and-position
PRINTL 11: s04-missing-image
PRINTL 12: s04-canvas-two-pixels-revision
PRINTL 13: s04-canvas-invalid-dimensions
PRINTL 14: s04-canvas-outside-x
PRINTL 15: s04-full-layout-later-rows
PRINTL 16: s04-file-two-pixels
PRINTL 17: s04-length-int32-units
PRINTL 98: pointer (real client only; requires an actual hover/click)
INPUT
PRINTL S04_ENTRY_BEGIN
SELECTCASE RESULT
CASE 1
    CALL S04_CASE_EMPTY
CASE 2
    CALL S04_CASE_FIRST_ROW
CASE 3
    CALL S04_CASE_LINES
CASE 4
    CALL S04_CASE_SPLIT_BREAK
CASE 5
    CALL S04_CASE_UNICODE
CASE 6
    CALL S04_CASE_ENTITIES
CASE 7
    CALL S04_CASE_AMP_ERROR
CASE 8
    CALL S04_CASE_LATE_ERROR
CASE 9
    CALL S04_CASE_LAZY_FRONTIER
CASE 10
    CALL S04_CASE_STYLE
CASE 11
    CALL S04_CASE_MISSING_IMAGE
CASE 12
    CALL S04_CASE_CANVAS
CASE 13
    CALL S04_CASE_CANVAS_ERROR
CASE 14
    CALL S04_CASE_CANVAS_OUTSIDE
CASE 15
    CALL S04_CASE_LATER_ROWS
CASE 16
    CALL S04_CASE_FILE
CASE 17
    CALL S04_CASE_LENGTH_UNITS
CASE 98
    CALL S04_CASE_POINTER
CASEELSE
    PRINTL S04_UNKNOWN_CASE
ENDSELECT
PRINTL S04_CASE_COMPLETE
PRINTFORML S04_RESULT_10={RESULT:10}
PRINTFORML S04_RESULT_11={RESULT:11}
PRINTFORML S04_RESULT_12={RESULT:12}
PRINTFORML S04_RESULT_13={RESULT:13}
PRINTFORML S04_RESULT_14={RESULT:14}
PRINTFORML S04_RESULT_15={RESULT:15}
PRINTFORML S04_RESULT_16={RESULT:16}
PRINTFORML S04_RESULT_17={RESULT:17}
PRINTFORML S04_RESULT_18={RESULT:18}
PRINTFORML S04_RESULT_19={RESULT:19}
